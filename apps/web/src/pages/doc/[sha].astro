---
import { asc, eq } from "drizzle-orm";
import { documents, pages } from "@blueport/db/schema";
import { getConnector } from "@blueport/db/connectors";
import { getDb } from "../../lib/db";
import { scoreDocument, TIER_STYLES } from "../../lib/credibility";
import nuforc from "../../data/nuforc.json";

const { sha } = Astro.params;

if (!sha || !/^[a-f0-9]{64}$/i.test(sha)) {
  return new Response("Not found", { status: 404 });
}

const env = Astro.locals.runtime.env;
const db = getDb(env);

const docRow = await db
  .select()
  .from(documents)
  .where(eq(documents.sha256, sha))
  .limit(1);

const doc = docRow[0];
if (!doc) {
  return new Response("Not found", { status: 404 });
}

const pageRows = await db
  .select()
  .from(pages)
  .where(eq(pages.docSha, sha))
  .orderBy(asc(pages.pageNumber));

const verifiedDate = new Date(doc.fetchedAt).toISOString().slice(0, 10);
const docDateLabel = doc.documentDate
  ? new Date(doc.documentDate).toISOString().slice(0, 10)
  : null;
const incidentDateLabel = doc.incidentDate
  ? new Date(doc.incidentDate).toISOString().slice(0, 10)
  : null;
const showIncident = incidentDateLabel && incidentDateLabel !== docDateLabel;

const title = doc.title ?? "(untitled)";
const sourceLabel = getConnector(doc.sourceId)?.label ?? doc.sourceDomain;
const isWithheld = doc.status === "referenced_withheld";
const hasStoredPdf = doc.r2Key !== "" && doc.mediaType === "pdf";

const cred = scoreDocument(doc);
// Cross-layer context: civilian (NUFORC) reports in the same decade as the incident.
const incidentYear = doc.incidentDate ? new Date(doc.incidentDate).getFullYear() : null;
const decade = incidentYear ? Math.floor(incidentYear / 10) * 10 : null;
const decadeSightings = decade
  ? (nuforc.decades as { decade: number; n: number }[]).find((d) => d.decade === decade)?.n ?? null
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} · Blueport</title>
    {doc.summary && <meta name="description" content={doc.summary} />}
  </head>
  <body class="bg-zinc-950 text-zinc-100 font-mono">
    <main class="max-w-3xl mx-auto px-6 py-12">
      <a href="/" class="text-xs text-zinc-500 hover:text-zinc-200">← Blueport</a>

      <header class="mt-4">
        <h1 class="text-2xl font-bold tracking-tight text-balance">{title}</h1>
        <div class="mt-3 flex flex-wrap gap-2 text-xs">
          {isWithheld && (
            <span class="rounded bg-amber-900/40 px-1.5 py-0.5 text-amber-300">referenced · withheld</span>
          )}
          {doc.docType && (
            <span class="rounded bg-zinc-800 px-1.5 py-0.5 text-zinc-300">{doc.docType}</span>
          )}
          {doc.mediaType !== "pdf" && (
            <span class="rounded bg-zinc-800 px-1.5 py-0.5 text-zinc-300">{doc.mediaType}</span>
          )}
          {doc.country && (
            <span class="rounded border border-zinc-800 px-1.5 py-0.5 text-zinc-400">{doc.country}</span>
          )}
          {docDateLabel && (
            <span class="rounded border border-zinc-800 px-1.5 py-0.5 text-zinc-400">doc {docDateLabel}</span>
          )}
          {showIncident && (
            <span class="rounded border border-zinc-800 px-1.5 py-0.5 text-zinc-400">incident {incidentDateLabel}</span>
          )}
          {doc.pageCount != null && (
            <span class="rounded border border-zinc-800 px-1.5 py-0.5 text-zinc-400">{doc.pageCount} pages</span>
          )}
          <span class="rounded border border-zinc-800 px-1.5 py-0.5 text-zinc-400">{sourceLabel}</span>
        </div>
      </header>

      <section class="mt-8 rounded border border-zinc-800 bg-zinc-900/40 p-4 text-xs leading-relaxed text-zinc-400">
        <h2 class="mb-2 text-xs uppercase tracking-wide text-zinc-500">Provenance</h2>
        <dl class="grid grid-cols-1 gap-1 sm:grid-cols-[8rem_1fr]">
          <dt class="text-zinc-500">sha256</dt>
          <dd class="break-all text-zinc-300">{doc.sha256}</dd>
          <dt class="text-zinc-500">source</dt>
          <dd class="break-all">
            <a href={doc.sourceUrl} class="underline hover:text-zinc-200" rel="noreferrer">{doc.sourceUrl}</a>
          </dd>
          <dt class="text-zinc-500">verified</dt>
          <dd>against {doc.sourceDomain} on {verifiedDate}</dd>
          <dt class="text-zinc-500">original</dt>
          <dd>
            {hasStoredPdf ? (
              <a href={`/api/pdf/${doc.sha256}`} class="underline hover:text-zinc-200">View original PDF</a>
            ) : isWithheld ? (
              <span class="text-amber-300">Not released — referenced only</span>
            ) : (
              <a href={doc.sourceUrl} class="underline hover:text-zinc-200" rel="noreferrer">View at source ({doc.mediaType})</a>
            )}
          </dd>
        </dl>
      </section>

      <section class="mt-6 rounded border border-zinc-800 bg-zinc-900/40 p-4">
        <div class="flex items-center justify-between">
          <h2 class="text-xs uppercase tracking-wide text-zinc-500">Credibility</h2>
          <span class={`rounded px-2 py-0.5 text-xs ${TIER_STYLES[cred.tier]}`}>{cred.tier} · {cred.score}/100</span>
        </div>
        <ul class="mt-3 space-y-1.5 text-xs">
          {cred.factors.map((f) => (
            <li class="flex items-center gap-2">
              <span class="w-48 shrink-0 truncate text-zinc-400">{f.label}</span>
              <span class="h-2 flex-1 rounded-sm bg-zinc-800">
                <span class="block h-2 rounded-sm bg-emerald-400/60" style={`width:${Math.round((f.points / f.max) * 100)}%`}></span>
              </span>
              <span class="w-12 shrink-0 text-right text-zinc-500">{f.points}/{f.max}</span>
            </li>
          ))}
        </ul>
        {decadeSightings != null && (
          <p class="mt-3 text-xs text-zinc-500">
            Cross-layer context: <span class="text-zinc-300">{decadeSightings.toLocaleString()}</span> civilian NUFORC sightings were reported in the {decade}s. (Temporal context, not corroboration.)
          </p>
        )}
      </section>

      {doc.summary && (
        <section class="mt-6">
          <h2 class="text-xs uppercase tracking-wide text-zinc-500">Summary</h2>
          <p class="mt-2 text-sm text-zinc-300 leading-relaxed">{doc.summary}</p>
        </section>
      )}

      {(doc.skepticTake || doc.analystTake) && (
        <section class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
          {doc.skepticTake && (
            <div class="rounded border border-zinc-800 bg-zinc-900/40 p-4">
              <h3 class="text-xs uppercase tracking-wide text-zinc-500">Skeptic take</h3>
              <p class="mt-2 text-sm text-zinc-300 leading-relaxed">{doc.skepticTake}</p>
            </div>
          )}
          {doc.analystTake && (
            <div class="rounded border border-zinc-800 bg-zinc-900/40 p-4">
              <h3 class="text-xs uppercase tracking-wide text-zinc-500">Analyst take</h3>
              <p class="mt-2 text-sm text-zinc-300 leading-relaxed">{doc.analystTake}</p>
            </div>
          )}
        </section>
      )}

      <section class="mt-8 space-y-4">
        <h2 class="text-xs uppercase tracking-wide text-zinc-500">Pages</h2>
        {pageRows.length === 0 && (
          <div class="rounded border border-zinc-800 bg-zinc-900/40 p-6 text-sm text-zinc-400">
            No pages indexed yet for this document.
          </div>
        )}
        {pageRows.map((p) => (
          <article id={`page-${p.pageNumber}`} class="rounded border border-zinc-800 bg-zinc-900/40 p-4 scroll-mt-8">
            <div class="mb-2 flex items-center gap-2 text-xs text-zinc-500">
              <span class="font-semibold text-zinc-300">page {p.pageNumber}</span>
              {p.hasRedactions && (
                <span class="rounded bg-red-900/40 px-1.5 py-0.5 text-red-300">REDACTED</span>
              )}
              <a href={`#page-${p.pageNumber}`} class="ml-auto text-zinc-600 hover:text-zinc-300">#</a>
            </div>
            <pre class="whitespace-pre-wrap break-words text-sm text-zinc-200 leading-relaxed">{p.text}</pre>
          </article>
        ))}
      </section>
    </main>
  </body>
</html>
