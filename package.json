{
  "name": "blueport",
  "version": "0.0.1",
  "private": true,
  "description": "Source-grounded archive of UAP/UFO documents released by governments",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @blueport/web dev",
    "build": "pnpm --filter @blueport/web build",
    "crawler:dev": "pnpm --filter @blueport/crawler dev",
    "crawler:deploy": "pnpm --filter @blueport/crawler deploy",
    "db:generate": "pnpm --filter @blueport/db generate",
    "db:migrate": "pnpm --filter @blueport/db migrate",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
