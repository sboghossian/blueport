---
import { desc } from "drizzle-orm";
import { documents } from "@blueport/db/schema";
import { getDb } from "../lib/db";
import DocCard from "../components/DocCard.astro";

const title = "Blueport — UAP archive";
const tagline = "Every UAP document declassified by governments. Page-cited. Hash-anchored. Skeptic and analyst takes side by side.";

const env = Astro.locals.runtime.env;
const db = getDb(env);

const latest = await db
  .select()
  .from(documents)
  .orderBy(desc(documents.fetchedAt))
  .limit(5);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={tagline} />
    <link rel="alternate" type="application/rss+xml" title="Blueport" href="/rss.xml" />
  </head>
  <body class="bg-zinc-950 text-zinc-100 font-mono">
    <main class="max-w-3xl mx-auto px-6 py-16">
      <section>
        <h1 class="text-4xl font-bold tracking-tight">Blueport</h1>
        <p class="mt-4 text-zinc-400 text-balance">{tagline}</p>

        <form method="get" action="/search" class="mt-8 flex gap-2">
          <input
            type="text"
            name="q"
            placeholder="Search documents (e.g. nimitz, project blue book)…"
            class="flex-1 rounded border border-zinc-800 bg-zinc-900 px-3 py-2 text-sm text-zinc-100 placeholder:text-zinc-600 focus:border-zinc-500 focus:outline-none"
          />
          <button
            type="submit"
            class="rounded border border-zinc-700 bg-zinc-800 px-4 py-2 text-sm font-medium text-zinc-100 hover:bg-zinc-700"
          >
            Search
          </button>
        </form>
      </section>

      <section class="mt-16">
        <div class="flex items-baseline justify-between">
          <h2 class="text-xs uppercase tracking-wide text-zinc-500">Latest archives</h2>
          <span class="flex gap-4 text-xs text-zinc-500">
            <a href="/activity" class="hover:text-zinc-200">activity →</a>
            <a href="/map" class="hover:text-zinc-200">map →</a>
            <a href="/new" class="hover:text-zinc-200">all new →</a>
          </span>
        </div>
        <div class="mt-3 space-y-3">
          {latest.length === 0 && (
            <div class="rounded border border-zinc-800 bg-zinc-900/40 p-6 text-sm text-zinc-400">
              Crawler hasn't ingested anything yet. Check back after the next 6-hourly cron tick.
            </div>
          )}
          {latest.map((doc) => <DocCard doc={doc} />)}
        </div>
      </section>

      <section class="mt-16">
        <h2 class="text-xs uppercase tracking-wide text-zinc-500">What this is</h2>
        <p class="mt-3 text-sm text-zinc-400 leading-relaxed">
          Blueport is an open archive of UAP/UFO documents released by governments. Every page is OCR'd,
          cited by page number, and anchored to a SHA-256 hash so you can verify the original wasn't tampered with.
          Each document is paired with a skeptic take and an analyst take — read both, draw your own conclusions.
        </p>
      </section>

      <footer class="mt-20 flex items-center justify-between border-t border-zinc-900 pt-6 text-xs text-zinc-600">
        <span>Pre-alpha · multi-source — see <a href="/activity" class="underline hover:text-zinc-300">release activity</a></span>
        <span class="flex gap-4">
          <a href="https://github.com/sboghossian/blueport" class="hover:text-zinc-300">GitHub</a>
          <a href="/rss.xml" class="hover:text-zinc-300">RSS</a>
        </span>
      </footer>
    </main>
  </body>
</html>
