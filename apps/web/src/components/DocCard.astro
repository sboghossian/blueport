---
import type { documents } from "@blueport/db/schema";
import { getConnector } from "@blueport/db/connectors";
import { scoreDocument, TIER_STYLES } from "../lib/credibility";

type Doc = typeof documents.$inferSelect;

interface Props {
  doc: Doc;
  snippet?: string | undefined;
  snippetHtml?: string | undefined;
  pageAnchor?: number | null | undefined;
}

const { doc, snippet, snippetHtml, pageAnchor } = Astro.props;

const href = pageAnchor != null
  ? `/doc/${doc.sha256}#page-${pageAnchor}`
  : `/doc/${doc.sha256}`;

const fetchedLabel = doc.fetchedAt
  ? new Date(doc.fetchedAt).toISOString().slice(0, 10)
  : "—";

const sourceLabel = getConnector(doc.sourceId)?.label ?? doc.sourceDomain;
const isWithheld = doc.status === "referenced_withheld";
const cred = scoreDocument(doc);
---

<a
  href={href}
  class="block rounded border border-zinc-800 bg-zinc-900/40 p-4 hover:border-zinc-600 hover:bg-zinc-900/70 transition-colors"
>
  <div class="flex items-baseline justify-between gap-4">
    <h3 class="text-base font-semibold text-zinc-100 truncate">
      {doc.title ?? "(untitled)"}
    </h3>
    <span class="shrink-0 text-xs text-zinc-500">{fetchedLabel}</span>
  </div>
  <div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-zinc-500">
    <span class={`rounded px-1.5 py-0.5 ${TIER_STYLES[cred.tier]}`} title={`Credibility ${cred.score}/100`}>
      {cred.tier} {cred.score}
    </span>
    {isWithheld && (
      <span class="rounded bg-amber-900/40 px-1.5 py-0.5 text-amber-300">withheld</span>
    )}
    {doc.country && (
      <span class="rounded border border-zinc-700 px-1.5 py-0.5 text-zinc-400">{doc.country}</span>
    )}
    {doc.docType && (
      <span class="rounded bg-zinc-800 px-1.5 py-0.5 text-zinc-300">{doc.docType}</span>
    )}
    {doc.mediaType !== "pdf" && (
      <span class="rounded bg-zinc-800 px-1.5 py-0.5 text-zinc-300">{doc.mediaType}</span>
    )}
    <span class="truncate">{sourceLabel}</span>
    {doc.pageCount != null && <span>· {doc.pageCount}p</span>}
  </div>
  {snippetHtml ? (
    <p class="mt-3 text-sm text-zinc-400 leading-relaxed" set:html={snippetHtml} />
  ) : snippet ? (
    <p class="mt-3 text-sm text-zinc-400 leading-relaxed">{snippet}</p>
  ) : doc.summary ? (
    <p class="mt-3 text-sm text-zinc-400 leading-relaxed line-clamp-3">{doc.summary}</p>
  ) : null}
</a>
